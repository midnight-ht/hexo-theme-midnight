<!doctype html>
<html
  lang="<%= midnight_page_lang(page) %>"
  data-code-copy="<%= midnight_text('labels.code_copy', 'Copy') %>"
  data-code-copied="<%= midnight_text('labels.code_copied', 'Copied') %>"
  data-code-failed="<%= midnight_text('labels.code_failed', 'Failed') %>"
  data-code-copy-label="<%= midnight_text('labels.code_copy_label', 'Copy code') %>"
  data-code-copied-label="<%= midnight_text('labels.code_copied_label', 'Code copied') %>"
>
  <%- partial('_partial/head') %>
  <% const studioHome = ['', ...((theme.i18n && theme.i18n.languages) || [])].includes(String(page.path || '').replace(/index\.html?$/i, '').replace(/^\/+|\/+$/g, '')); %>
  <body<% if (studioHome) { %> class="studio-page"<% } %>>
    <%- partial('_partial/language-redirect-skeleton') %>
    <a class="skip-link" href="#content"><%= midnight_text('labels.skip_to_content', 'Skip to content') %></a>
    <div class="site-shell">
      <%- partial(studioHome ? '_partial/studio-header' : '_partial/header') %>
      <main class="site-main" id="content">
        <%- body %>
      </main>
      <%- partial(studioHome ? '_partial/studio-footer' : '_partial/footer') %>
    </div>
    <% const layoutAssetVersion = theme.asset_version || theme.version || '0.3.0'; %>
    <script src="<%- url_for('/js/main.js') %>?v=<%- layoutAssetVersion %>" defer></script>
    <% if (theme.model_session && theme.model_session.enabled && String(theme.model_session.endpoint || '').trim()) { %>
      <script src="<%- url_for('/js/model-session.js') %>?v=<%- layoutAssetVersion %>" defer></script>
    <% } %>
    <% if (midnight_config('article_statistics.enabled', false) === true && midnight_config('article_statistics.provider', '') === 'endpoint' && (midnight_config('article_statistics.reads_endpoint', '') || midnight_config('article_statistics.comments_endpoint', ''))) { %>
      <script src="<%- url_for('/js/statistics.js') %>" defer></script>
    <% } %>
    <% if (studioHome) { %><script src="<%- url_for('/js/studio.js') %>" defer></script><% } %>
    <%- partial('_partial/analytics') %>
  </body>
</html>
