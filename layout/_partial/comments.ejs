<%
const comments = theme.comments || {};
const commentsEnabled = (comments.enabled === true || comments.enable === true) && page.comments !== false;
const commentsProvider = comments.provider || comments.type || '';
const walineConfig = comments.waline || {};
const walineServerUrl = walineConfig.server_url || walineConfig.serverURL || '';
const utterancesConfig = comments.utterances || {};
%>
<% if (commentsEnabled) { %>
  <section class="comments" aria-label="<%= __('comments') %>">
    <h2><%= __('comments') %></h2>
    <% let renderedProvider = false; %>
    <% if (commentsProvider === 'giscus' && comments.giscus && comments.giscus.repo && comments.giscus.repo_id) { %>
      <% renderedProvider = true; %>
      <script src="https://giscus.app/client.js"
        data-repo="<%- comments.giscus.repo %>"
        data-repo-id="<%- comments.giscus.repo_id %>"
        data-category="<%- comments.giscus.category %>"
        data-category-id="<%- comments.giscus.category_id %>"
        data-mapping="<%- comments.giscus.mapping || 'pathname' %>"
        data-reactions-enabled="<%- comments.giscus.reactions_enabled || '1' %>"
        data-emit-metadata="<%- comments.giscus.emit_metadata || '0' %>"
        data-theme="<%- comments.giscus.theme || 'preferred_color_scheme' %>"
        crossorigin="anonymous"
        async>
      </script>
    <% } else if (commentsProvider === 'waline' && walineServerUrl) { %>
      <% renderedProvider = true; %>
      <div id="waline"></div>
      <script type="module">
        import { init } from 'https://unpkg.com/@waline/client/dist/waline.js';
        init({
          el: '#waline',
          serverURL: '<%- walineServerUrl %>',
          <% if (walineConfig.lang) { %>lang: '<%- walineConfig.lang %>',<% } %>
          <% if (walineConfig.placeholder) { %>placeholder: '<%- walineConfig.placeholder %>',<% } %>
          pageSize: <%- Number(walineConfig.page_size || walineConfig.pageSize || 10) %>
        });
      </script>
    <% } else if (commentsProvider === 'utterances' && utterancesConfig.repo) { %>
      <% renderedProvider = true; %>
      <script src="https://utteranc.es/client.js"
        repo="<%- utterancesConfig.repo %>"
        issue-term="<%- utterancesConfig.issue_term || utterancesConfig.issueTerm || 'pathname' %>"
        <% if (utterancesConfig.label) { %>label="<%- utterancesConfig.label %>"<% } %>
        theme="<%- utterancesConfig.theme || 'github-dark' %>"
        crossorigin="<%- utterancesConfig.crossorigin || 'anonymous' %>"
        async>
      </script>
    <% } %>
    <% if (!renderedProvider) { %>
      <div class="empty-state">
        <strong><%= midnight_text('labels.comments_unavailable', 'Comments unavailable') %></strong>
        <p><%= midnight_text('labels.comments_unavailable_description', 'Comments are enabled, but the selected provider is missing required configuration.') %></p>
      </div>
    <% } %>
  </section>
<% } %>
