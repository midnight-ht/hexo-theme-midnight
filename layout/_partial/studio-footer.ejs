<footer class="studio-footer"><div class="studio-container"><div class="studio-footer__top"><p><%= midnight_value(theme.appearance && theme.appearance.tagline, config.subtitle || config.title) %></p><a class="studio-text-link" href="<%- midnight_i18n_url('/about/') %>"><%= __('about') %> <span aria-hidden="true">↗</span></a></div><div class="studio-footer__wordmark" aria-hidden="true"><%= (theme.appearance && theme.appearance.logo_text) || config.title %><span>.</span></div><div class="studio-footer__bottom"><div><span>&copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title %></span><%- partial('_partial/footer-statistics') %></div><nav aria-label="<%= midnight_text('labels.footer_resources', 'Resources') %>"><a href="<%- midnight_i18n_url('/archives/') %>"><%= __('archives') %></a><% if (midnight_config('feed.enabled', true) !== false) { %><a href="<%- url_for('/' + String((config.feed && config.feed.path) || midnight_config('feed.path', 'atom.xml')).replace(/^\/+/, '')) %>">RSS</a><% } %><% if (String(midnight_config('inner_pages.newsletter.form.action', '') || '').trim()) { %><a href="<%- midnight_i18n_url('/newsletter/') %>"><%= __('newsletter') %></a><% } %><a href="<%- midnight_i18n_url('/privacy/') %>"><%= __('privacy') %></a><a href="<%- midnight_i18n_url('/advertise/') %>"><%= __('advertise') %></a></nav><a href="#content" class="studio-back-top"><%= midnight_page_lang(page) === 'en' ? 'Back to top' : '回到顶部' %> <span aria-hidden="true">↑</span></a></div></div></footer>