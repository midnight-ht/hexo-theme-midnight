<% const studioEnglish = midnight_page_lang(page) === 'en'; const studioBrand = (theme.appearance && theme.appearance.logo_text) || config.title; %>
<header class="site-header studio-header"><div class="studio-container studio-header__inner">
<a class="studio-brand" href="<%- midnight_i18n_url('/') %>"><%- partial('_partial/studio-mark') %><span><%= studioBrand %><span class="studio-brand__dot">.</span></span></a>
<nav class="studio-nav" aria-label="<%= midnight_text('labels.primary_navigation', 'Primary') %>"><a href="#studio-articles"><%= studioEnglish ? 'Writing' : '文章' %></a><a href="#studio-topics"><%= studioEnglish ? 'Topics' : '专题' %></a><a href="<%- midnight_i18n_url('/about/') %>"><%= __('about') %> <span aria-hidden="true">↗</span></a></nav>
<details class="studio-desktop-controls studio-preferences"><summary><span><%= midnight_text('labels.color_scheme', 'Appearance') %></span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M12 5a7 7 0 0 1 0 14Z" fill="currentColor"/></svg></summary><div class="studio-preferences__panel"><%- partial('_partial/studio-controls') %></div></details>
<button class="mobile-menu-toggle studio-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu"><span class="sr-only"><%= midnight_text('labels.mobile_menu', 'Menu') %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button>
</div>
<div class="mobile-menu-backdrop" data-mobile-menu-close hidden></div>
<aside class="mobile-menu" id="mobile-menu" data-mobile-menu hidden aria-hidden="true"><div class="mobile-menu__head"><strong><%= studioBrand %></strong><button class="mobile-menu__close" type="button" data-mobile-menu-close aria-label="<%= midnight_text('labels.close_menu', 'Close menu') %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><nav class="mobile-menu__nav" aria-label="<%= midnight_text('labels.primary_navigation', 'Primary') %>"><a href="#studio-articles"><%= studioEnglish ? 'Writing' : '文章' %></a><a href="#studio-topics"><%= studioEnglish ? 'Topics' : '专题' %></a><a href="<%- midnight_i18n_url('/archives/') %>"><%= __('archives') %></a><a href="<%- midnight_i18n_url('/about/') %>"><%= __('about') %></a></nav><%- partial('_partial/studio-controls') %></aside></header>
