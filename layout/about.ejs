<%
const about = midnight_config('inner_pages.about', {});
const hasPageAboutContent = Boolean(page.content && strip_html(page.content).replace(/\s+/g, '').trim());
const title = page.title || midnight_value(about.title, __('about'));
const description = page.description || midnight_value(about.description, config.description || theme.description || '');
const mission = midnight_value(about.mission, '');
const principles = about.principles || [];
const aboutMap = (about.map || []).slice(0, 4);
const authorName = config.author || (theme.appearance && (theme.appearance.nick || theme.appearance.logo_text)) || config.title || 'midnight';
const authorInitial = Array.from(String(authorName).trim())[0] || 'm';
const contactConfig = about.contact || {};
const contactIsObject = contactConfig && typeof contactConfig === 'object' && !Array.isArray(contactConfig);
const contact = contactIsObject ? contactConfig : { description: contactConfig };
const contactName = midnight_value(contact.name, authorName);
const contactRole = midnight_value(contact.role, midnight_text('labels.publisher_role', 'Publisher / Editor'));
const contactAvatar = contact.avatar || (theme.appearance && theme.appearance.logo) || '';
const contactDescription = midnight_value(contact.description, '');
const contactFooter = midnight_value(contact.footer, '');
const normalizeContactLink = (item) => {
  const type = String(item.type || item.name || '').trim().toLowerCase();
  const platformTypes = new Set(['wechat', 'weixin', 'email', 'mail', 'github', 'csdn']);
  if (platformTypes.has(type)) return `type:${type === 'weixin' ? 'wechat' : type === 'mail' ? 'email' : type}`;
  return String(item.url || item.href || item.image || item.qr || item.qrcode || type)
    .trim()
    .toLowerCase();
};
const contactLinkKeys = new Set();
const contactLinks = Array.isArray(contact.links)
  ? contact.links.filter((item) => {
      if (!item || !(item.url || item.href || item.image || item.qr || item.qrcode)) return false;
      const key = normalizeContactLink(item);
      if (contactLinkKeys.has(key)) return false;
      contactLinkKeys.add(key);
      return true;
    })
  : [];
const body = midnight_value(about.body, '');
const contactInitial = Array.from(String(contactName).trim())[0] || authorInitial;
const contactIcon = (type = '') => {
  switch (String(type).toLowerCase()) {
    case 'wechat':
    case 'weixin':
      return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.4 5.2C5.8 5.2 3 7.5 3 10.5c0 1.7.9 3.2 2.3 4.2l-.5 2 2.3-1.1c.7.2 1.5.3 2.3.3 3.5 0 6.4-2.4 6.4-5.3S12.9 5.2 9.4 5.2Zm-2.2 4.4c-.5 0-.9-.3-.9-.8s.4-.8.9-.8.9.3.9.8-.4.8-.9.8Zm4.3 0c-.5 0-.9-.3-.9-.8s.4-.8.9-.8.9.3.9.8-.4.8-.9.8Z"/><path d="M21 13.7c0-2.6-2.5-4.7-5.6-4.7h-.2c.2.5.3 1 .3 1.6 0 3.2-3 5.9-6.8 6.3 1 1 2.6 1.6 4.3 1.6.7 0 1.4-.1 2-.3l2 1-.4-1.7c2.6-.9 4.4-2.9 4.4-3.8Zm-7.5-1c.4 0 .8.3.8.7s-.3.7-.8.7-.8-.3-.8-.7.3-.7.8-.7Zm3.8 1.4c-.4 0-.8-.3-.8-.7s.3-.7.8-.7.8.3.8.7-.3.7-.8.7Z"/></svg>';
    case 'email':
    case 'mail':
      return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5h15a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16V8a1.5 1.5 0 0 1 1.5-1.5Zm.6 2.2 6.4 4.2c.3.2.7.2 1 0l6.4-4.2-.8-.7-6.1 4-6.1-4-.8.7Z"/></svg>';
    case 'github':
      return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.7a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.2 9.2 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.3 4.5-4.6 4.7.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.4 9.4 0 0 0 12 2.7Z"/></svg>';
    case 'csdn':
      return '<span aria-hidden="true">C</span>';
    default:
      return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.2 13.8a1 1 0 0 1 0-1.4l4-4a2.6 2.6 0 0 1 3.7 3.7l-2.2 2.2a1 1 0 1 0 1.4 1.4l2.2-2.2a4.6 4.6 0 1 0-6.5-6.5l-4 4a1 1 0 0 0 1.4 1.4Zm3.6-3.6a1 1 0 0 1 0 1.4l-4 4a2.6 2.6 0 0 1-3.7-3.7l2.2-2.2a1 1 0 1 0-1.4-1.4l-2.2 2.2a4.6 4.6 0 1 0 6.5 6.5l4-4a1 1 0 0 0-1.4-1.4Z"/></svg>';
  }
};
%>

<article class="inner-page about-page">
  <header class="inner-hero about-hero">
    <div class="inner-hero__body">
      <div class="inner-hero__kicker"><%= midnight_text('labels.about_kicker', 'About Midnight') %></div>
      <h1><%= title %></h1>
      <% if (description) { %>
        <p><%= description %></p>
      <% } %>
      <div class="inner-hero__meta">
        <span class="tag tag--about"><%= midnight_text('labels.about_kicker', 'About') %></span>
        <span class="inner-hero__path">midnight / about</span>
      </div>
    </div>
    <div class="inner-hero__cover" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>
  </header>

  <section class="collection-layout inner-layout-v2">
    <main class="collection-list">
      <section class="channel-section about-block">
        <div class="section-heading">
          <h2><%= midnight_text('labels.about_mission', 'Mission') %></h2>
          <p><%= midnight_text('labels.about_mission_description', '') %></p>
        </div>
        <% if (mission) { %>
          <p class="about-lede"><%= mission %></p>
        <% } %>
        <% if (hasPageAboutContent) { %>
          <div class="article-content">
            <%- page.content %>
          </div>
        <% } else if (body) { %>
          <div class="article-content">
            <p><%= body %></p>
          </div>
        <% } %>
      </section>

      <% if (aboutMap.length) { %>
        <section class="channel-section channel-map-section">
          <div class="section-heading">
            <h2><%= midnight_text('labels.about_map', 'About Map') %></h2>
            <p><%= midnight_text('labels.about_map_description', '') %></p>
          </div>
          <div class="channel-map">
            <% aboutMap.forEach((item) => { %>
              <article class="channel-map__card">
                <h3><%= midnight_value(item.title, '') %></h3>
                <p><%= midnight_value(item.body, '') %></p>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (principles.length) { %>
        <section class="channel-section about-block">
          <div class="section-heading">
            <h2><%= midnight_text('labels.about_principles', 'Principles') %></h2>
            <p><%= midnight_text('labels.about_principles_description', '') %></p>
          </div>
          <div class="about-principles">
            <% principles.forEach((item) => { %>
              <article>
                <h3><%= midnight_value(item.title, '') %></h3>
                <p><%= midnight_value(item.description, '') %></p>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>
    </main>

    <aside class="collection-sidebar inner-sidebar">
      <section class="sidebar-panel author-panel">
        <h2><%= midnight_text('labels.author', 'Author') %></h2>
        <p><%= midnight_text('labels.author_description', '') %></p>
        <div>
          <span class="avatar avatar--large"><%= authorInitial %></span>
          <strong><%= authorName %></strong>
          <small><%= midnight_text('labels.publisher_role', 'Publisher / Editor') %></small>
        </div>
      </section>

      <% if (contactDescription || contactLinks.length || contactFooter) { %>
        <section class="sidebar-panel contact-panel">
          <h2><%= midnight_text('labels.about_contact', 'Contact') %></h2>
          <div class="contact-card">
            <% if (contactAvatar) { %>
              <img class="contact-card__avatar" src="<%- url_for(contactAvatar) %>" alt="<%= contactName %>">
            <% } else { %>
              <span class="avatar avatar--large"><%= contactInitial %></span>
            <% } %>
            <div>
              <strong><%= contactName %></strong>
              <% if (contactRole) { %>
                <small><%= contactRole %></small>
              <% } %>
            </div>
          </div>
          <% if (contactDescription) { %>
            <p><%= contactDescription %></p>
          <% } %>
          <% if (contactLinks.length) { %>
            <div class="contact-links" aria-label="<%= midnight_text('labels.about_contact', 'Contact') %>">
              <% contactLinks.forEach((item) => {
                const linkLabel = midnight_value(item.label, item.type || item.name || 'Link');
                const linkType = item.type || item.name || '';
                const linkUrl = item.url || item.href || '#';
                const linkImage = item.image || item.qr || item.qrcode || '';
                const linkClass = String(linkType || 'link').toLowerCase().replace(/[^a-z0-9_-]/g, '');
              %>
                <a class="contact-link contact-link--<%= linkClass %><% if (linkImage) { %> contact-link--image<% } %>" href="<%- linkUrl %>" aria-label="<%= linkLabel %>" title="<%= linkLabel %>"<% if (/^https?:\/\//i.test(linkUrl)) { %> target="_blank" rel="noopener noreferrer"<% } %>>
                  <span class="contact-link__icon"><%- contactIcon(linkType) %></span>
                  <% if (linkImage) { %>
                    <span class="contact-link__bubble" role="presentation">
                      <img src="<%- url_for(linkImage) %>" alt="">
                    </span>
                  <% } %>
                </a>
              <% }) %>
            </div>
          <% } %>
          <% if (contactFooter) { %>
            <footer class="contact-panel__footer"><%= contactFooter %></footer>
          <% } %>
        </section>
      <% } %>

      <%- partial('_partial/inner-sidebar', { variant: 'about', showSponsored: false }) %>
    </aside>
  </section>
</article>

<%- partial('_partial/comments') %>
