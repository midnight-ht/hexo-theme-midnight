<%
function configText(path, fallback) {
  return midnight_text(path, fallback);
}

const latestPosts = site.posts && site.posts.toArray
  ? site.posts.toArray().filter(post => midnight_page_lang(post) === midnight_page_lang(page)).sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 4)
  : [];
%>

<section class="not-found">
  <div class="not-found__hero">
    <span><%= configText('labels.not_found_kicker', '404') %></span>
    <h1><%= page.title && page.title !== 'Page Not Found' ? page.title : configText('labels.not_found_title', __('not_found_title')) %></h1>
    <p><%= configText('labels.not_found_description', __('not_found_description')) %></p>

    <div class="not-found__actions">
      <a href="<%- midnight_i18n_url('/') %>"><%= __('home') %></a>
      <a href="<%- midnight_i18n_url('/archives/') %>"><%= __('archives') %></a>
    </div>
  </div>

  <% if (latestPosts.length) { %>
    <div class="not-found__latest">
      <h2><%= __('latest_posts') %></h2>
      <% latestPosts.forEach((post) => { %>
        <a href="<%- midnight_i18n_url(post.path) %>">
          <strong><%= post.title %></strong>
          <small><%= date(post.date, 'YYYY-MM-DD') %></small>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
