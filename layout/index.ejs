<%
const homeLang = midnight_page_lang(page);
const english = homeLang === 'en';
const posts = (page.posts && page.posts.toArray ? page.posts.toArray() : []).filter(post => midnight_page_lang(post) === homeLang).sort((a,b) => b.date - a.date);
const homePosts = posts.slice(0, 6);
const collections = midnight_config('inner_pages.collections', []);
const author = config.author || (theme.appearance && theme.appearance.logo_text) || config.title;
const tagline = midnight_value(theme.appearance && theme.appearance.tagline, config.subtitle || config.title);
const headlineParts = String(tagline).split('，');
const bio = midnight_text('labels.author_description', '');
function tagOf(post) { const tags = post.tags && post.tags.data ? post.tags.data : (Array.isArray(post.tags) ? post.tags : []); return typeof tags[0] === 'string' ? tags[0] : tags[0] && tags[0].name; }
function tagLabel(name) { const item = collections.find(item => item.name === name); return item ? midnight_value(item.label, name) : name; }
function collectionHref(item) { const parts = String(item.path || '').split('/').filter(Boolean); const i = parts.indexOf('tags'); return i >= 0 ? midnight_tag_url(parts[i+1]) : midnight_i18n_url(item.path || '/'); }
const topics = collections.filter(item => posts.some(post => { const tags = post.tags && post.tags.data ? post.tags.data : (Array.isArray(post.tags) ? post.tags : []); return tags.some(tag => (typeof tag === 'string' ? tag : tag.name) === item.name); }));
%>
<section class="studio-hero">
  <div class="studio-container studio-hero__grid">
    <div class="studio-hero__copy">
      <h1><% if (!english && headlineParts.length === 2) { %><span><%= headlineParts[0] %>，</span><span><%= headlineParts[1] %><span class="studio-type-dot" aria-hidden="true">.</span></span><% } else { %><%= tagline %><% } %></h1>
      <% if (bio) { %><p class="studio-hero__description"><%= bio %></p><% } %>
      <div class="studio-hero__actions"><a class="studio-primary-link" href="#studio-articles"><%= english ? 'Explore the journal' : '阅读文章' %><span class="studio-arrow" aria-hidden="true">↘</span></a><a class="studio-author-link" href="<%- midnight_i18n_url('/about/') %>"><span><%= author %></span><span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="studio-art" data-studio-art aria-hidden="true"><div class="studio-art__motion"><%- partial('_partial/studio-loop') %></div></div>
  </div>
  <div class="studio-container studio-hero__bottom"><span><%= english ? 'Engineering notes, from idea to operation.' : '把想法写清楚，把系统做扎实。' %></span><a href="#studio-articles" class="studio-scroll-link" aria-label="<%= english ? 'Scroll to articles' : '跳转到文章' %>"><span aria-hidden="true">↓</span></a></div>
</section>
<section class="studio-writing" id="studio-articles" aria-labelledby="studio-latest">
<div class="studio-container">
  <div class="studio-section-heading"><div><span class="studio-section-index" aria-hidden="true">01 /</span><h2 id="studio-latest"><%= __('latest_posts') %></h2></div><a class="section-heading__more studio-text-link" href="<%- midnight_i18n_url('/archives/') %>"><%= english ? 'All writing' : '全部文章' %><span aria-hidden="true">↗</span></a></div>
  <div class="studio-entries">
  <% homePosts.forEach((post,index) => { const tag = tagOf(post); const excerpt = midnight_excerpt(post, 150); %>
  <article class="studio-entry<%= index === 0 ? ' studio-entry--lead' : '' %>" data-studio-reveal>
    <div class="studio-entry__date"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %><small><%= date(post.date, 'YYYY') %></small></time></div>
    <div class="studio-entry__body"><% if (tag) { %><a class="studio-entry__topic" href="<%- midnight_tag_url(tag) %>"><%= tagLabel(tag) %></a><% } %><h3><a href="<%- midnight_i18n_url(post.path) %>"><%= post.title %></a></h3><% if (excerpt) { %><p><%= excerpt %></p><% } %><div class="studio-entry__metrics"><%- partial('_partial/metric', { item: post, kind: 'reads', metricTag: 'span' }) %><%- partial('_partial/metric', { item: post, kind: 'comments', metricTag: 'span' }) %></div></div>
    <a class="studio-entry__open" href="<%- midnight_i18n_url(post.path) %>" tabindex="-1" aria-hidden="true"><span>↗</span></a>
  </article>
  <% }) %>
  <% if (!homePosts.length) { %><p class="studio-empty"><%= midnight_text('labels.no_posts', 'No Posts Yet') %></p><% } %>
  </div>
</div></section>
<% if (topics.length) { %>
<section class="studio-topics" id="studio-topics" aria-labelledby="studio-topics-title"><div class="studio-container"><div class="studio-section-heading"><div><span class="studio-section-index" aria-hidden="true">02 /</span><h2 id="studio-topics-title"><%= english ? 'Follow a thread' : '沿着问题，继续探索' %></h2></div><span class="studio-topics__note"><%= english ? 'Notes across the software lifecycle' : '从需求到运行的工程实践' %></span></div><div class="studio-topic-list"><% topics.forEach((item,index) => { %><a href="<%- collectionHref(item) %>"><span class="studio-topic-index" aria-hidden="true">0<%= index+1 %></span><span><%= midnight_value(item.label, item.name) %></span><span aria-hidden="true">↗</span></a><% }) %></div></div></section>
<% } %>
